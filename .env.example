# ============================================================================
# VERCEL — RUNTIME DO SITE (Production + Preview)
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
CRON_SECRET=

# Revisão privada — somente servidor, nunca use prefixo NEXT_PUBLIC_
# Na Vercel, ausente também bloqueia o site; use false somente no lançamento.
SITE_REVIEW_ENABLED=true
SITE_REVIEW_USER=6dnx
SITE_REVIEW_PASSWORD=

# Discord — suporte e pedidos
DISCORD_INVITE_URL=https://discord.gg/your-invite
DISCORD_WEBHOOK_URL=
DISCORD_TICKET_WEBHOOK_URL=

# Supabase — servidor
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Supabase — browser/auth do painel (públicas, protegidas por RLS)
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ainda não usada pelo frontend atual; o provedor Google fica no Supabase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Checkout real futuro — Mercado Pago TESTE primeiro
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# StorM Wallet — PIX real futuro (somente servidor)
# Preencha a URL somente após receber e validar o contrato oficial da API.
# Webhook StorM futuro: https://your-project.vercel.app/api/webhooks/storm-wallet
# O webhook do Discord pertence a DISCORD_TICKET_WEBHOOK_URL.
STORM_WALLET_API_URL=
STORM_WALLET_API_KEY=
STORM_WALLET_WEBHOOK_SECRET=

# Automação avançada de tickets Discord (opcional; ainda não usada)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_SUPPORT_ROLE_ID=

# Vercel Preview somente. Em Production mantenha false/ausente.
# PAYMENT_TEST_MODE=true

# ============================================================================
# SOMENTE FERRAMENTAS LOCAIS — NÃO COPIAR PARA O RUNTIME DA VERCEL
# ============================================================================
# Uso único por `npm run admin:create`; apague a senha após criar a conta.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_URL=
VERCEL_TOKEN=
